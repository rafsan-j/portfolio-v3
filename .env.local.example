# ============================================================================
# RAFSAN JANI PORTFOLIO v2.0 — ENVIRONMENT VARIABLES (.env.local)
# Copy this file to `.env.local` for local dev, and add these in Vercel → Settings → Environment Variables.
# NOTE: The site has a built-in zero-downtime fallback layer, so it will build
# and run cleanly on Vercel even before you fill in these keys!
# ============================================================================

# ── 1. Supabase (Database, Admin CMS, Inbox & Visitor Counter) ───────────────
# Get from: https://supabase.com → Your Project → Project Settings → API
# After creating a project, paste `supabase/migration.sql` into SQL Editor → Run.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── 2. Dual AI Providers (RJ.AI Assistant — Both Work Automatically!) ────────
# Provide EITHER Groq OR Gemini (or BOTH for automatic failover!).
# Option A: Groq (Free & ultra-fast Llama 3.3 70B) → https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Option B: Google Gemini (Free tier Gemini 2.5 / 2.0 Flash) → https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here

# ── 3. Admin Dashboard Password (/admin) ─────────────────────────────────────
# Password used to unlock the `/admin` Control Center (defaults to rafsan2972 if unset)
NEXT_PUBLIC_ADMIN_PASS=change_me_to_something_secret

# ── 4. Resend Email Auto-Reply (Optional — for /contact form) ────────────────
# Free tier at https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL="Rafsan Jani <onboarding@resend.dev>"

# ── 5. Public Site URL ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
